{
  "name": "pepper-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A visual task board where an agent grooms and you decide.",
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta -k --kill-others-on-fail \"bun run server:dev\" \"bun run web:dev\"",
    "server:dev": "bun run --watch server/index.ts",
    "server:start": "bun run server/index.ts",
    "web:dev": "cd web && bun run dev",
    "web:build": "cd web && bun run build",
    "web:install": "cd web && bun install",
    "typecheck": "tsc --noEmit && cd web && bun run typecheck",
    "test": "bun test",
    "lint": "bun run scripts/privacy-lint.ts ./sample-vault"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "gray-matter": "^4.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "concurrently": "^10.0.3",
    "typescript": "^5.5.4"
  }
}
