# Copy this file to .env and fill in values.
# .env is gitignored — NEVER commit real paths, tokens, or keys.
#   cp .env.example .env

# Path to the vault the dashboard reads/writes.
# Defaults to the committed sample data so the app clones-and-runs with no setup.
VAULT_PATH=./sample-vault

# Agent provider for the "groom my day" action:
#   mock   -> deterministic local proposal, no external calls (default; what clones/graders use)
#   hermes -> live agent via your own Hermes gateway (fill in the two values below)
AGENT_PROVIDER=mock

# Only needed when AGENT_PROVIDER=hermes. Keep these OUT of git.
HERMES_GATEWAY_URL=
HERMES_TOKEN=
