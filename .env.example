# Copy this file to .env and fill in values you need.
# .env is gitignored — NEVER commit real paths, tokens, or keys.
#   cp .env.example .env

# ─── Vault ───────────────────────────────────────────────────────────
# Path to the vault the dashboard reads/writes.
# Defaults to the committed sample data so the app clones-and-runs.
VAULT_PATH=./sample-vault

# ─── Server ──────────────────────────────────────────────────────────
PORT=3000

# Where the server listens. 127.0.0.1 = localhost only (default + safest).
# Set to 0.0.0.0 to expose on your LAN — REQUIRES DASHBOARD_TOKEN below.
BIND_HOST=127.0.0.1

# Required when BIND_HOST is not 127.0.0.1 / localhost.
# Generate a strong random token, e.g.  openssl rand -hex 32
DASHBOARD_TOKEN=

# ─── Agent ───────────────────────────────────────────────────────────
# mock   -> deterministic local proposal, no external calls (graders use this)
# hermes -> live agent via subprocess `hermes -z <prompt> --yolo --accept-hooks`
AGENT_PROVIDER=mock

# Path to the `hermes` binary. Leave blank to auto-resolve via PATH.
HERMES_BIN=

# Max time to wait for `hermes -z` to return before SIGKILL.
HERMES_TIMEOUT_MS=90000

# ─── Logging ─────────────────────────────────────────────────────────
# info (default) or debug
LOG_LEVEL=info
